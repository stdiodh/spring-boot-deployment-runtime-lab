# Production replaces this example with the exact 40-character commit-SHA image.
APP_IMAGE=docker.io/example/aandi-deployment-runtime-lab:0000000000000000000000000000000000000000
SPRING_PROFILES_ACTIVE=prod
APP_DOMAIN=api.example.com
CERTBOT_EMAIL=operator@example.com

DB_URL=jdbc:mysql://mysql:3306/aandi_lab?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=aandi
DB_PASSWORD=change-this-app-db-password

REDIS_HOST=redis
REDIS_PORT=6379

JWT_SECRET=replace-with-at-least-32-byte-random-secret
JWT_EXPIRATION_MS=3600000

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-mail@example.com
MAIL_PASSWORD=your-mail-password

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

APP_FRONTEND_URL=https://api.example.com/realtime-demo.html
APP_PASSWORD_RESET_URL=https://api.example.com/auth-demo.html
APP_WEBSOCKET_ALLOWED_ORIGIN_PATTERNS=https://api.example.com

MYSQL_DATABASE=aandi_lab
MYSQL_USER=aandi
MYSQL_PASSWORD=change-this-app-db-password
MYSQL_ROOT_PASSWORD=change-this-root-db-password
